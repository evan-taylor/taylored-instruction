    {
      "includes": [
        "components/registration/**/*.tsx",
        "components/admin/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": [
                  "Input",
                  "TextInput",
                  "TextArea",
                  "Select",
                  "MoneyInput"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": { "rules": { "suspicious": { "noUnknownAtRules": "off" } } }
    },
    {
      "includes": ["components/ui/**/*.tsx"],
      "linter": { "rules": { "performance": { "noNamespaceImport": "off" } } }
    },
    {
      "includes": ["next.config.js"],
      "linter": {
        "rules": {
          "style": { "noMagicNumbers": "off" },
          "suspicious": { "useAwait": "off" }
        }
      }
    },
    {
      "includes": ["scripts/*.js"],
      "linter": { "rules": { "suspicious": { "useAwait": "off" } } }
    },
    {
      "includes": ["app/**/page.tsx", "app/layout.tsx"],
      "linter": {
        "rules": { "security": { "noDangerouslySetInnerHtml": "off" } }
      }
    },
    {
      "includes": ["app/(marketing)/**/*.tsx"],
      "linter": { "rules": { "suspicious": { "useAwait": "off" } } }
    },
    {
      "includes": ["convex/tsconfig.json", "convex/_generated/**"],
      "json": { "parser": { "allowComments": true } }
    },
    {
      "includes": ["convex/**/*.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
