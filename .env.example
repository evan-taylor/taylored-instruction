# Next.js development. See docs/development.md for runtime ownership.
# Let `convex dev` select the backend and write these values to .env.local.
# Do not copy a shared development target into an isolated agent workspace.
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Stripe. The publishable key renders the on-page payment form and must match the
# mode of the Convex STRIPE_SECRET_KEY (pk_test with sk_test, pk_live with sk_live).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Next.js server integrations; use test Stripe credentials in dev/preview.
STRIPE_SECRET_KEY=
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=
ADMIN_NOTIF_EMAIL=
INTERNAL_EMAIL_WEBHOOK_SECRET=
NOTION_API_KEY=
NOTION_INSTRUCTOR_PAGE_ID=

# CMS, analytics, and monitoring
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
SIGHT_AI_WEBHOOK_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Convex-only settings: configure these with `bunx convex env set`, not here.
# REGISTRATION_MODE=test (dev/preview), live (production)
# POSTHOG_PROJECT_TOKEN, POSTHOG_HOST (same project as the browser; direct ingest host)
# STRIPE_SECRET_KEY, REGISTRATION_STRIPE_WEBHOOK_SECRET
# REGISTRATION_TEST_RECIPIENT (required in test mode)
# RESEND_API_KEY, AUTH_EMAIL_FROM, SITE_URL, optional REGISTRATION_ADMIN_EMAIL
# JWT_PRIVATE_KEY, JWKS, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
# RESEND_WEBHOOK_SECRET (specific to this deployment's delivery-event endpoint)
# Optional legacy notifications: FROM_EMAIL, WEBSITE_NAME, RESEND_AUDIENCE_ID
# Never enable REGISTRATION_ALLOW_TEST_FIXTURES or
# NEXT_PUBLIC_REGISTRATION_TEST_LOGIN on shared deployments.
# Vercel also needs a separate CONVEX_DEPLOY_KEY for production and preview.
